# Docker Compose loads .env automatically. Copy this file to .env.
SALON_BIND_ADDRESS=127.0.0.1
SALON_PORT=18093
SALON_TIMEZONE=Etc/UTC

# Public website (separate from the staff dashboard).
WEBSITE_BIND_ADDRESS=127.0.0.1
WEBSITE_PORT=18094

# Leave blank to disable automatic email reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Demo project only; use an unused port and your own timezone.
